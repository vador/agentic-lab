# Loaded by direnv (`direnv allow` once per worktree; `agt new` does it for you).

# One compose project and one emulator port per worktree => parallel agents don't collide.
export COMPOSE_PROJECT_NAME="__ORG__-__REPO__-$(basename "$PWD")"
export FLOCI_PORT=$(( 20000 + $(printf '%s' "$PWD" | cksum | cut -d' ' -f1) % 10000 ))

# AWS SDKs / CLI / Terraform all honor AWS_ENDPOINT_URL
export AWS_ENDPOINT_URL="http://127.0.0.1:${FLOCI_PORT}"
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=us-east-1

dotenv_if_exists .env.local
